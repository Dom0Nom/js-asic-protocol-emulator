[tasks]
bmc
cover
cover_hint

[options]
bmc: mode bmc
bmc: depth 60
cover: mode cover
cover: depth 60
cover_hint: mode cover
cover_hint: depth 45
multiclock off

[engines]
smtbmc bitwuzla

[script]
read_verilog -formal -I../src tempo_lane.v
~cover_hint: read_verilog -formal -sv lane_miter.sv
cover_hint: read_verilog -formal -sv -DMITER_HINT lane_miter.sv
prep -top lane_miter

[files]
../src/tempo_lane.v
lane_miter.sv
